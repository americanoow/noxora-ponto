# Copie para deploy/.env.prod e preencha. NUNCA versione o arquivo preenchido.
DOMAIN=ponto.exemplo.com.br
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=ponto.exemplo.com.br,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://ponto.exemplo.com.br
DJANGO_BEHIND_TLS_PROXY=true
DJANGO_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=1
FRONTEND_URL=https://ponto.exemplo.com.br

# Banco: a aplicação usa o papel SEM privilégio de dono; o migrate usa o dono.
POSTGRES_OWNER_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgres://noxora_app:SENHA_APP@db:5432/noxora
MIGRATE_DATABASE_URL=postgres://noxora_owner:SENHA_DONO@db:5432/noxora
# Supabase (alternativa): postgres://USUARIO:SENHA@HOST:5432/postgres?sslmode=require (pooler em modo sessão)

REDIS_URL=redis://redis:6379/0

# E-mail (SMTP real). O envio é feito pelo worker (outbox).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Noxora Ponto <nao-responda@exemplo.com.br>
EMAIL_OUTBOX_SYNC=false

# Biometria: chaves em arquivo de segredo (JSON {"id": "<32 bytes base64>"}), motor OpenCV.
BIOMETRIC_ENGINE=opencv
BIOMETRIC_KEYS_FILE=/run/secrets/biometric_keys
BIOMETRIC_ACTIVE_KEY_ID=k1
TIMECLOCK_ALLOW_REGISTRATION_ONLY=true

# REP-P (externos): preencher quando existirem.
REP_P_INPI_REGISTRATION=
REP_P_DEVELOPER_TAX_ID=
AFD_LAYOUT_VERSION=003

# Cobrança: somente sandbox até a contratação de um gateway.
BILLING_GATEWAY=sandbox
BILLING_WEBHOOK_SECRET=
LOG_LEVEL=INFO
